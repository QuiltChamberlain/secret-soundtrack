rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{document} {
      // Allow write (create and update) for deduplication. No reading or deleting.
      allow write: if request.resource.data.keys().hasAll(['email', 'playlistUrl', 'timestamp'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('.*@.*\\..*')
                    && request.resource.data.playlistUrl is string
                    && (request.resource.data.playlistUrl == '' || request.resource.data.playlistUrl.matches('^https?://.*'));
    }
    
    // Default rule: block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}